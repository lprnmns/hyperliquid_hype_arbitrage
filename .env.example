# Hyperliquid API Configuration
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Account Configuration (CHANGE THESE!)
HL_API_AGENT_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
HL_API_AGENT_WALLET_ADDRESS=0x_YOUR_WALLET_ADDRESS_HERE

# Trading Parameters
PERP_SYMBOL=HYPE
SPOT_SYMBOL=@107
BPS_THRESHOLD=5.0
POSITION_SIZE_USD=20.0
LEVERAGE=2

# Risk Management
MAX_POSITION_SIZE_USD=100.0
STOP_LOSS_BPS=50.0
MAX_DAILY_LOSS_USD=50.0

# Execution Settings
TIMEOUT_SECONDS=30
MAX_RETRIES=3
RATE_LIMIT_PER_MIN=90

# Operation Mode
DRY_RUN=true
MANUAL_TEST_TRADE=false
DEBUG_MODE=false

# Monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_ERROR=true